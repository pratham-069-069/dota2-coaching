# ==========================================================
# Dota 2 Coaching Platform — Environment Configuration
# ==========================================================

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=80

# Logging
LOG_LEVEL=info

# Container Registry Configuration
# Defaults to GitHub Container Registry (ghcr.io/<owner>/dota2-coaching)
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=your-github-username/dota2-coaching
IMAGE_TAG=latest

# Frontend API Base URL
# In production behind Nginx reverse proxy, leave blank or set to /api
VITE_API_BASE_URL=

# Watchtower Auto-deploy Polling Interval (in seconds)
WATCHTOWER_INTERVAL=60

