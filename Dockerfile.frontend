# syntax=docker/dockerfile:1
# -------------------------------------------------------------
# Dota 2 Coaching Intelligence Platform — Frontend Dockerfile
# Multi-stage build: Node.js Vite build -> Nginx Alpine server
# -------------------------------------------------------------

# Stage 1: Build the React Application
FROM node:20-alpine AS builder

WORKDIR /app

# Cache package dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source files
COPY frontend/ ./

# Build arguments (optional API base URL override)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build optimized production bundle
RUN npm run build

# Stage 2: Serve with lightweight Nginx Alpine
FROM nginx:alpine-slim

# Copy custom reverse-proxy and SPA routing configuration
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# Healthcheck for frontend web server
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

